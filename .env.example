# ════════════════════════════════════════════════════════════════════
#  Skyloom — 环境变量样例 / Environment variable reference
# ════════════════════════════════════════════════════════════════════
#
#  Skyloom 的首选配置方式是 `~/.skyloom/config.yaml`（运行 `sky` 的设置向导
#  自动生成）。本文件仅作为「有哪些变量可用」的参考清单 —— 复制为 `.env`
#  并按需填写，或直接 export 到你的 shell。`.env` 已被 .gitignore 忽略。
#
#  Skyloom prefers `~/.skyloom/config.yaml` for persistent config. This file
#  is a reference for the env vars Skyloom reads. Copy to `.env` and fill in
#  what you need (`.env` is gitignored), or export them in your shell.
#  Only set the API key for the provider(s) you actually use.

# ─── LLM Provider API Keys ───────────────────────────────────────────
# 国际 / International
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
REKA_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=

# 国内 / Chinese providers
QWEN_API_KEY=
ZHIPU_API_KEY=
LINGYIWANWU_API_KEY=
MINIMAX_API_KEY=
MOONSHOT_API_KEY=
BAIDU_API_KEY=
BAICHUAN_API_KEY=
STEPFUN_API_KEY=

# ─── 本地 / 自托管模型端点（OpenAI 兼容） ───────────────────────────
# Local / self-hosted endpoints. Override only if not on the default port.
# OLLAMA_HOST=http://localhost:11434/v1
# LMSTUDIO_HOST=http://localhost:1234/v1
# VLLM_HOST=http://localhost:8000/v1
# LITELLM_HOST=http://localhost:4000/v1

# ─── 运行时开关 / Runtime flags ──────────────────────────────────────
# SKYLOOM_CLASSIC=1                 # 强制经典线性 TUI（跳过立轴全屏模式）
# SKYLOOM_WEB_HOST=0.0.0.0          # Web UI 对外开放（默认仅本机；无鉴权，谨慎）
# SKYLOOM_WORKSPACE_FENCE=1         # 限制文件操作在工作区根目录内
# SKYLOOM_WORKSPACE_ROOT=           # 显式指定工作区根（默认 cwd）
# SKYLOOM_ALLOW_DANGEROUS=1         # 允许高危命令（默认红线拦截，谨慎）
# SKYLOOM_ALLOW_PRIVATE_FETCH=1     # 关闭 SSRF 防护，允许请求内网/环回地址
# SKYLOOM_ALLOW_UNSAFE_PLUGINS=1    # 允许加载未签名插件
# SKYLOOM_LOG_FILE=                 # 结构化日志写入路径
# SKYLOOM_LOG_CONSOLE=1             # 日志同时打到 stderr

# ─── 记忆 / 自动抽取调优 / Memory & auto-extraction tuning ───────────
# WA_NO_RESUME=1                    # 禁用上次会话自动恢复
# WA_RESUME_GAP_SECONDS=1800        # 超过此空闲秒数才开新会话
# WA_NO_RECALL=1                    # 禁用长期记忆语义召回
# WA_NO_EXTRACT=1                   # 禁用从对话自动抽取事实
# WA_EXTRACT_EVERY_N=4              # 每 N 轮抽取一次事实

# ─── 渠道网关 / Gateway (sky gateway) ────────────────────────────────
# SKYLOOM_GATEWAY_HOST=0.0.0.0
# SKYLOOM_GATEWAY_PORT=8848

# 飞书 / Feishu (Lark)
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_ENCRYPT_KEY=              # 可选：开启加密时
# FEISHU_VERIFICATION_TOKEN=       # 可选

# 企业微信 / WeCom
# WECOM_CORP_ID=
# WECOM_CORP_SECRET=
# WECOM_TOKEN=
# WECOM_AES_KEY=                   # 43 位 EncodingAESKey
# WECOM_AGENT_ID=

# QQ 官方机器人 / QQ Bot
# QQ_BOT_APPID=
# QQ_BOT_SECRET=

# ─── 语音合成 / Text-to-Speech (火山引擎 Volcano Engine) ─────────────
# VOLC_ACCESS_TOKEN=
# VOLC_APP_ID=
